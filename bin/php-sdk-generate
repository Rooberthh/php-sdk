#!/usr/bin/env php
<?php

/**
 * SDK Generator Script
 *
 * Generates a new SDK with authentication support and sample User resource.
 * Run with: composer generate-sdk
 * @param string $question
 * @param string $default
 */

function prompt(string $question, string $default = ''): string
{
    $defaultText = $default ? " [$default]" : '';
    echo "$question$defaultText: ";
    $input = trim(fgets(STDIN));

    return $input === '' && $default !== '' ? $default : $input;
}

function confirm(string $question): bool
{
    $answer = strtolower(prompt("$question (yes/no)", 'yes'));

    return in_array($answer, ['yes', 'y', 'true', '1']);
}

function selectOption(string $question, array $options): string
{
    echo "$question\n";
    foreach ($options as $key => $label) {
        echo "  [$key] $label\n";
    }

    do {
        $selection = prompt('Select an option', array_key_first($options));

        if (isset($options[$selection])) {
            return $selection;
        }

        echo "Error: Invalid option. Please select from the available options.\n";
    } while (true);
}

function validateSdkName(string $name): bool
{
    return preg_match('/^[A-Za-z][A-Za-z0-9]*$/', $name);
}

function validatePath(string $path): bool
{
    // Check if path is relative (not starting with /)
    return !str_starts_with($path, '/');
}

function generateNamespace(string $sdkName): string
{
    return ucfirst($sdkName);
}

function ensureDirectory(string $path): void
{
    if (!is_dir($path)) {
        mkdir($path, 0755, true);
        echo "Created directory: $path\n";
    }
}

function writeFile(string $path, string $content): void
{
    file_put_contents($path, $content);
    echo "Generated: $path\n";
}

function generateClientClass(string $namespace, string $className, ?string $authType): string
{
    $implements = $authType ? ' implements AuthenticationContract' : '';
    $imports = '';
    $constructorArgs = '';
    $authMethod = '';

    if ($authType !== null) {
        $imports = "use Http\\Message\\Authentication;\n";
    }

    if ($authType === 'bearer') {
        $imports .= "use Http\\Message\\Authentication\\Bearer;\n";
        $constructorArgs = "\n        private readonly string \$token,";
        $authMethod = "
    public function authentication(): Authentication
    {
        return new Bearer(\$this->token);
    }
";
    } elseif ($authType === 'basic') {
        $imports .= "use Http\\Message\\Authentication\\BasicAuth;\n";
        $constructorArgs = "\n        private readonly string \$username,\n        private readonly string \$password,";
        $authMethod = "
    public function authentication(): Authentication
    {
        return new BasicAuth(\$this->username, \$this->password);
    }
";
    }

    // Credentials are promoted constructor properties on purpose: authentication()
    // is called from parent::__construct(), and promoted properties are assigned
    // before the parent constructor body runs. Assigning them afterwards would
    // fail with "must not be accessed before initialization".
    $constructor = <<<CTOR

    public function __construct(
        string \$url,{$constructorArgs}
        ?Builder \$builder = null,
    ) {
        parent::__construct(\$url, \$builder);
    }

CTOR;

    $authUse = $authType ? "use Rooberthh\\Sdk\\Contracts\\AuthenticationContract;\n" : '';

    return <<<PHP
<?php

declare(strict_types=1);

namespace {$namespace};

{$imports}use Rooberthh\Sdk\Client;
{$authUse}use Rooberthh\Sdk\Http\Builder;
use {$namespace}\Resources\UserResource;

class {$className} extends Client{$implements}
{{$constructor}
    public function users(): UserResource
    {
        return new UserResource(\$this);
    }
{$authMethod}}

PHP;
}

function generateResourceClass(string $namespace, string $resourceName, string $dataObjectName): string
{
    return <<<PHP
<?php

declare(strict_types=1);

namespace {$namespace}\Resources;

use Rooberthh\Sdk\Concerns\Resources\CanAccessClient;
use Rooberthh\HttpTools\Enums\Method;
use {$namespace}\DataObjects\\{$dataObjectName};

class {$resourceName}
{
    use CanAccessClient;

    /**
     * Fetch a single user by ID.
     *
     * @param int \$id The user ID
     * @return {$dataObjectName}
     */
    public function show(int \$id): {$dataObjectName}
    {
        return \$this->client
            ->request(Method::GET, "/users/{\$id}")
            ->dto({$dataObjectName}::class);
    }
}

PHP;
}

function generateDataObjectClass(string $namespace, string $className): string
{
    return <<<PHP
<?php

declare(strict_types=1);

namespace {$namespace}\DataObjects;

use Rooberthh\Sdk\Concerns\DataObjects\CanCreateInstances;
use Rooberthh\Sdk\Contracts\DataObjectContract;

readonly class {$className} implements DataObjectContract
{
    use CanCreateInstances;

    public function __construct(
        public int \$id,
        public string \$name,
        public string \$email,
    ) {
    }
}

PHP;
}

// Main execution
echo "\n";
echo "========================================\n";
echo "     SDK Generator                      \n";
echo "========================================\n";
echo "\n";

// Step 1: Get SDK name
do {
    $sdkName = prompt('Enter the SDK name (e.g., MyApi, GitHub, Stripe)');

    if (empty($sdkName)) {
        echo "Error: SDK name cannot be empty.\n";
        continue;
    }

    if (!validateSdkName($sdkName)) {
        echo "Error: SDK name must start with a letter and contain only letters and numbers.\n";
        continue;
    }

    break;
} while (true);

// Step 2: Get installation path
do {
    $installPath = prompt('Enter the path relative to current directory (e.g., sdks/myapi)', 'php-sdk/' . strtolower($sdkName));

    if (empty($installPath)) {
        echo "Error: Path cannot be empty.\n";
        continue;
    }

    if (!validatePath($installPath)) {
        echo "Error: Path must be relative (not starting with /).\n";
        continue;
    }

    break;
} while (true);

// Step 3: Ask about authentication
$useAuth = confirm('Do you want to use authentication?');

$authType = null;
if ($useAuth) {
    echo "\n";
    $authType = selectOption('Which authentication type would you like to use?', [
        'bearer' => 'Bearer Token',
        'basic' => 'Basic Authentication',
    ]);
}

// Generate namespace and class names
$namespace = generateNamespace($sdkName);
$clientClassName = "{$sdkName}Client";

$authLabel = 'None';
if ($authType === 'bearer') {
    $authLabel = 'Bearer Token';
} elseif ($authType === 'basic') {
    $authLabel = 'Basic Authentication';
}

echo "\n";
echo "Configuration:\n";
echo "  SDK Name: $sdkName\n";
echo "  Namespace: $namespace\n";
echo "  Path: $installPath\n";
echo "  Authentication: $authLabel\n";
echo "\n";

$proceed = confirm('Proceed with generation?');

if (!$proceed) {
    echo "Generation cancelled.\n";
    exit(0);
}

echo "\n";
echo "Generating SDK...\n";
echo "\n";

// Create directory structure
$basePath = getcwd() . '/' . $installPath;
ensureDirectory($basePath);
ensureDirectory($basePath . '/Resources');
ensureDirectory($basePath . '/DataObjects');

// Generate Client class
$clientContent = generateClientClass($namespace, $clientClassName, $authType);
writeFile($basePath . '/' . $clientClassName . '.php', $clientContent);

// Generate UserResource class
$resourceContent = generateResourceClass($namespace, 'UserResource', 'UserDataObject');
writeFile($basePath . '/Resources/UserResource.php', $resourceContent);

// Generate UserDataObject class
$dataObjectContent = generateDataObjectClass($namespace, 'UserDataObject');
writeFile($basePath . '/DataObjects/UserDataObject.php', $dataObjectContent);

echo "\n";
echo "========================================\n";
echo "  SDK generated successfully!          \n";
echo "========================================\n";
echo "\n";
echo "Generated files:\n";
echo "  - {$installPath}/{$clientClassName}.php\n";
echo "  - {$installPath}/Resources/UserResource.php\n";
echo "  - {$installPath}/DataObjects/UserDataObject.php\n";
echo "\n";
echo "Usage example:\n";
$credentialArgs = match ($authType) {
    'bearer' => ", 'your-api-token'",
    'basic'  => ", 'username', 'password'",
    default  => '',
};

echo "  \$client = new {$namespace}\\{$clientClassName}('https://api.example.com'{$credentialArgs});\n";
echo "  \$user = \$client->users()->show(1);\n";
echo "  echo \$user->name;\n";
echo "\n";
