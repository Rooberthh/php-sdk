{
    "preset": "per",
    "rules": {
        "declare_strict_types": true,
        "phpdoc_add_missing_param_annotation": {
            "only_untyped": false
        },
        "phpdoc_types_order": {
            "null_adjustment": "always_first"
        },
        "fully_qualified_strict_types": {
            "import_symbols": true
        },
        "phpdoc_order": {
            "order": [
                "param",
                "throws",
                "return"
            ]
        }
    }
}
